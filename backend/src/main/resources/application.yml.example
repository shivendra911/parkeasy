# ===========================================================
# ParkEasy Backend — Application Configuration (EXAMPLE)
# ===========================================================
# Copy this file to application.yml and fill in real values.
# NEVER commit application.yml with real credentials.
# ===========================================================

spring:
  application:
    name: parkeasy

  # --- Database (MySQL) ---
  datasource:
    url: jdbc:mysql://localhost:3306/parkeasy?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
    username: parkeasy_user
    password: CHANGE_ME

  # --- JPA / Hibernate ---
  jpa:
    hibernate:
      ddl-auto: validate          # Flyway owns the schema — never use 'update' or 'create'
    open-in-view: false           # Avoid lazy-loading surprises outside transactions
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect

  # --- Flyway ---
  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: false

# --- JWT ---
jwt:
  secret: REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS
  expiration-ms: 86400000        # 24 hours

# --- Server ---
server:
  port: 8080
  servlet:
    context-path: /api/v1

# --- Logging ---
logging:
  level:
    root: INFO
    com.parkeasy: DEBUG
    org.springframework.security: DEBUG
